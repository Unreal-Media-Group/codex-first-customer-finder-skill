{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unreal.local/schemas/lead-intelligence-package-real.schema.json",
  "title": "Unreal Phase 6 Real Public Lead Intelligence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "package_id",
    "idempotency_identity",
    "business_unit",
    "approved_result",
    "source_plan_hash",
    "dossier_id",
    "dossier_version",
    "research_cutoff",
    "maximum_evidence_age_days",
    "canonical_hash",
    "history_fingerprint",
    "qualification",
    "research_run",
    "source_coverage",
    "coverage_states",
    "claims",
    "evidence_inventory",
    "nodes",
    "edges",
    "duplicate_history",
    "review_release",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "synthetic": {"const": false},
    "package_id": {"$ref": "#/$defs/stableId"},
    "idempotency_identity": {"$ref": "#/$defs/stableId"},
    "business_unit": {"const": "unreal-media-group"},
    "approved_result": {"$ref": "customer-dossier-real.schema.json#/$defs/approvedResult"},
    "source_plan_hash": {"$ref": "#/$defs/hash"},
    "dossier_id": {"$ref": "#/$defs/stableId"},
    "dossier_version": {"type": "integer", "minimum": 1},
    "research_cutoff": {"type": "string", "format": "date-time"},
    "maximum_evidence_age_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "canonical_hash": {"$ref": "#/$defs/hash"},
    "history_fingerprint": {"$ref": "#/$defs/hash"},
    "qualification": {"$ref": "customer-dossier-real.schema.json#/$defs/qualification"},
    "research_run": {"$ref": "customer-dossier-real.schema.json#/$defs/researchRun"},
    "source_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "customer-dossier-real.schema.json#/$defs/sourceRecord"}
    },
    "coverage_states": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "claims": {
      "type": "array",
      "maxItems": 300,
      "items": {"$ref": "customer-dossier-real.schema.json#/$defs/claim"}
    },
    "evidence_inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 300,
      "items": {"$ref": "customer-dossier-real.schema.json#/$defs/evidence"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 600,
      "items": {"$ref": "#/$defs/edge"}
    },
    "duplicate_history": {"$ref": "customer-dossier.schema.json#/$defs/duplicateHistory"},
    "review_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_state", "release_state"],
      "properties": {
        "review_state": {"const": "research_quality_accepted"},
        "release_state": {"const": "released_local_data_only"}
      }
    },
    "authority": {"$ref": "customer-dossier-real.schema.json#/$defs/authority"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "coverage_state", "gap_explanation"],
      "properties": {
        "category": {"$ref": "customer-dossier-real.schema.json#/$defs/categoryName"},
        "coverage_state": {"enum": ["complete", "not_found", "not_applicable", "conflicted", "stale", "unknown"]},
        "gap_explanation": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "business_unit", "attributes"],
      "properties": {
        "node_id": {"$ref": "#/$defs/stableId"},
        "node_type": {"enum": ["organization", "brand", "business_role", "business_contact_route", "product_service", "audience_market", "campaign_asset_reference", "signal", "opportunity", "restriction", "evidence"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "business_unit": {"const": "unreal-media-group"},
        "attributes": {"type": "object", "maxProperties": 120}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "edge_type", "from_node_id", "to_node_id", "business_unit", "claim_refs", "evidence_refs"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/stableId"},
        "edge_type": {"enum": ["parent_subbrand", "agency_client", "partner", "affiliated_with", "responsible_for", "contact_path_for", "offers", "targets", "campaign_for", "evidence_supports", "duplicate", "prior_discovery", "reengagement"]},
        "from_node_id": {"$ref": "#/$defs/stableId"},
        "to_node_id": {"$ref": "#/$defs/stableId"},
        "business_unit": {"const": "unreal-media-group"},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}
      }
    }
  }
}
