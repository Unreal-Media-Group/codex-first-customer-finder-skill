{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unreal.local/schemas/customer-dossier.schema.json",
  "title": "Unreal Phase 6B Customer Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "dossier_id",
    "version",
    "idempotency_identity",
    "search_request_id",
    "business_unit",
    "approved_result",
    "research_cutoff",
    "maximum_evidence_age_days",
    "history_fingerprint",
    "duplicate_history",
    "evidence_inventory",
    "categories",
    "entities",
    "relationships",
    "review_state",
    "release_state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "synthetic": {"const": true},
    "dossier_id": {"$ref": "#/$defs/stableId"},
    "version": {"type": "integer", "minimum": 1},
    "idempotency_identity": {"$ref": "#/$defs/stableId"},
    "search_request_id": {"$ref": "#/$defs/stableId"},
    "business_unit": {"$ref": "#/$defs/businessUnit"},
    "approved_result": {"$ref": "#/$defs/approvedResult"},
    "research_cutoff": {"type": "string", "format": "date-time"},
    "maximum_evidence_age_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "history_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "duplicate_history": {"$ref": "#/$defs/duplicateHistory"},
    "evidence_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "categories": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/category"}
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/node"}
    },
    "relationships": {
      "type": "array",
      "maxItems": 300,
      "items": {"$ref": "#/$defs/edge"}
    },
    "review_state": {
      "enum": ["pending_research_quality_review", "research_quality_accepted", "changes_requested", "rejected"]
    },
    "release_state": {"enum": ["not_released", "released_local_data_only"]}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "businessUnit": {"enum": ["unreal-media-group", "unreal-talent"]},
    "approvedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "result_id", "global_identity_id", "account_id", "canonical_domain"],
      "properties": {
        "approval_id": {"$ref": "#/$defs/stableId"},
        "result_id": {"$ref": "#/$defs/stableId"},
        "global_identity_id": {"$ref": "#/$defs/stableId"},
        "account_id": {"$ref": "#/$defs/stableId"},
        "canonical_domain": {"type": "string", "pattern": "^[a-z0-9.-]+\\.example$"}
      }
    },
    "duplicateHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "matched_prospect_id", "matched_prospect_ids", "reengagement"],
      "properties": {
        "status": {"enum": ["new_prospect", "possible_duplicate_needs_review", "suppressed", "existing_client", "existing_partner", "existing_active_outreach", "parent_company_relationship", "distinct_subbrand", "agency_brand_overlap", "existing_no_new_trigger", "existing_new_trigger"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "matched_prospect_id": {"oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "matched_prospect_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "reengagement": {"type": "boolean"}
      },
      "oneOf": [
        {"properties": {"status": {"const": "new_prospect"}, "matched_prospect_id": {"type": "null"}, "matched_prospect_ids": {"maxItems": 0}, "reengagement": {"const": false}}},
        {"properties": {"status": {"const": "existing_new_trigger"}, "matched_prospect_id": {"$ref": "#/$defs/stableId"}, "matched_prospect_ids": {"minItems": 1}, "reengagement": {"const": true}}},
        {"properties": {"status": {"enum": ["possible_duplicate_needs_review", "suppressed", "existing_client", "existing_partner", "existing_active_outreach", "parent_company_relationship", "distinct_subbrand", "agency_brand_overlap", "existing_no_new_trigger"]}, "matched_prospect_id": {"$ref": "#/$defs/stableId"}, "matched_prospect_ids": {"minItems": 1}, "reengagement": {"const": false}}}
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_url", "source_kind", "source_date", "observed_at", "original_source", "summary", "conflict_state"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/stableId"},
        "source_url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https?://[^/?#]+\\.example(?:/[^?#]*)?$"},
        "source_kind": {
          "enum": ["official_site", "public_business_profile", "public_business_route", "public_professional_profile", "public_marketplace", "public_social", "public_news"]
        },
        "source_date": {"type": "string", "format": "date"},
        "observed_at": {"type": "string", "format": "date-time"},
        "original_source": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "conflict_state": {"enum": ["none", "conflicted"]}
      }
    },
    "typedValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "string"}, "value": {"type": "string", "minLength": 1, "maxLength": 2000}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "number"}, "value": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "boolean"}, "value": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "string_list"}, "value": {"type": "array", "minItems": 1, "maxItems": 300, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "date"}, "value": {"type": "string", "format": "date"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "url"}, "value": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https?://[^/?#]+\\.example(?:/[^?#]*)?$"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "object"}, "value": {"type": "object", "maxProperties": 120}}}
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "category", "subject_node_id", "typed_value", "basis", "evidence_refs", "confidence_reason", "uncertainty", "source_date", "observed_at", "freshness_state"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/stableId"},
        "category": {"$ref": "#/$defs/categoryName"},
        "subject_node_id": {"$ref": "#/$defs/stableId"},
        "typed_value": {"$ref": "#/$defs/typedValue"},
        "basis": {"enum": ["observed", "inferred_high_confidence", "inferred_low_confidence"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "confidence_reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "uncertainty": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_date": {"type": "string", "format": "date"},
        "observed_at": {"type": "string", "format": "date-time"},
        "freshness_state": {"enum": ["current", "stale", "conflicted", "unknown"]}
      }
    },
    "categoryName": {
      "enum": [
        "identity_and_relationships",
        "company_and_commercial_context",
        "operations_and_digital_footprint",
        "audiences_market_and_reputation",
        "brand_and_messaging",
        "activity_and_signals",
        "opportunity_and_fit",
        "public_people_and_contact_paths",
        "governance_and_history",
        "evidence_coverage",
        "additional_material_facts"
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "coverage_state", "claims"],
      "properties": {
        "category": {"$ref": "#/$defs/categoryName"},
        "coverage_state": {"enum": ["complete", "not_found", "not_applicable", "conflicted", "stale", "unknown"]},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "gap_explanation": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "oneOf": [
        {"properties": {"coverage_state": {"const": "complete"}, "claims": {"minItems": 1}}, "not": {"required": ["gap_explanation"]}},
        {"properties": {"coverage_state": {"enum": ["not_found", "not_applicable", "conflicted", "stale", "unknown"]}, "claims": {"maxItems": 0}}, "required": ["gap_explanation"]}
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "business_unit", "attributes"],
      "properties": {
        "node_id": {"$ref": "#/$defs/stableId"},
        "node_type": {"enum": ["organization", "brand", "business_role", "business_contact_route", "product_service", "audience_market", "campaign_asset_reference", "signal", "opportunity", "restriction"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "business_unit": {"$ref": "#/$defs/businessUnit"},
        "attributes": {"type": "object", "maxProperties": 120}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "edge_type", "from_node_id", "to_node_id", "business_unit", "claim_refs", "evidence_refs"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/stableId"},
        "edge_type": {"enum": ["parent_subbrand", "agency_client", "partner", "affiliated_with", "responsible_for", "contact_path_for", "offers", "targets", "campaign_for", "duplicate", "prior_discovery", "reengagement"]},
        "from_node_id": {"$ref": "#/$defs/stableId"},
        "to_node_id": {"$ref": "#/$defs/stableId"},
        "business_unit": {"$ref": "#/$defs/businessUnit"},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}
      },
      "anyOf": [
        {"properties": {"claim_refs": {"minItems": 1}}},
        {"properties": {"evidence_refs": {"minItems": 1}}}
      ]
    }
  }
}
