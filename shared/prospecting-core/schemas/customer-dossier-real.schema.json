{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unreal.local/schemas/customer-dossier-real.schema.json",
  "title": "Unreal Phase 6 Real Public Customer Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "dossier_id",
    "version",
    "idempotency_identity",
    "search_request_id",
    "business_unit",
    "approved_result",
    "source_plan_hash",
    "research_cutoff",
    "maximum_evidence_age_days",
    "history_fingerprint",
    "duplicate_history",
    "qualification",
    "research_run",
    "source_coverage",
    "evidence_inventory",
    "categories",
    "entities",
    "relationships",
    "review_state",
    "release_state",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "synthetic": {"const": false},
    "dossier_id": {"$ref": "#/$defs/stableId"},
    "version": {"type": "integer", "minimum": 1},
    "idempotency_identity": {"$ref": "#/$defs/stableId"},
    "search_request_id": {"$ref": "#/$defs/stableId"},
    "business_unit": {"const": "unreal-media-group"},
    "approved_result": {"$ref": "#/$defs/approvedResult"},
    "source_plan_hash": {"$ref": "#/$defs/hash"},
    "research_cutoff": {"type": "string", "format": "date-time"},
    "maximum_evidence_age_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "history_fingerprint": {"$ref": "#/$defs/hash"},
    "duplicate_history": {"$ref": "customer-dossier.schema.json#/$defs/duplicateHistory"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "research_run": {"$ref": "#/$defs/researchRun"},
    "source_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/sourceRecord"}
    },
    "evidence_inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "categories": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/category"}
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/node"}
    },
    "relationships": {
      "type": "array",
      "maxItems": 300,
      "items": {"$ref": "#/$defs/edge"}
    },
    "review_state": {
      "enum": ["pending_research_quality_review", "research_quality_accepted", "changes_requested", "rejected"]
    },
    "release_state": {"enum": ["not_released", "released_local_data_only"]},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicUrl": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://"},
    "approvedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "result_id",
        "global_identity_id",
        "account_id",
        "canonical_domain",
        "source_plan_id",
        "source_plan_hash"
      ],
      "properties": {
        "approval_id": {"$ref": "#/$defs/stableId"},
        "result_id": {"$ref": "#/$defs/stableId"},
        "global_identity_id": {"$ref": "#/$defs/stableId"},
        "account_id": {"$ref": "#/$defs/stableId"},
        "canonical_domain": {"type": "string", "minLength": 3, "maxLength": 253},
        "source_plan_id": {"$ref": "#/$defs/stableId"},
        "source_plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "basis", "search_intent_is_demand_evidence", "demand_evidence_found", "reason"],
      "properties": {
        "state": {"const": "potential_product_creative_fit"},
        "basis": {"const": "inferred_low_confidence"},
        "search_intent_is_demand_evidence": {"const": false},
        "demand_evidence_found": {"const": false},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "researchRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_version", "started_at", "completed_at"],
      "properties": {
        "bundle_version": {"const": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_version",
        "requested_url",
        "final_url",
        "redirect_chain",
        "source_class",
        "source_kind",
        "robots_url",
        "observed_at",
        "source_date",
        "date_state",
        "status",
        "safe_reason_code",
        "content_type",
        "body_sha256",
        "body_byte_length",
        "extracted_text_sha256",
        "extracted_text_byte_length",
        "summary",
        "conflict_state"
      ],
      "properties": {
        "source_record_version": {"const": 1},
        "requested_url": {"$ref": "#/$defs/publicUrl"},
        "final_url": {"oneOf": [{"$ref": "#/$defs/publicUrl"}, {"type": "null"}]},
        "redirect_chain": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/publicUrl"}},
        "source_class": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_kind": {
          "enum": ["official_site", "public_business_profile", "public_business_route", "public_professional_profile", "public_news"]
        },
        "robots_url": {"$ref": "#/$defs/publicUrl"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_date": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "date_state": {"enum": ["published_date", "observed_date_fallback", "unavailable"]},
        "status": {"enum": ["success", "failed"]},
        "safe_reason_code": {
          "enum": ["ok", "access_control", "body_limit", "content_rejected", "deadline", "dns_rejected", "http_status", "privacy_rejected", "redirect_rejected", "robots_denied", "robots_unavailable", "tls_rejected", "transport_error"]
        },
        "content_type": {"type": ["string", "null"]},
        "body_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "body_byte_length": {"type": "integer", "minimum": 0, "maximum": 2000000},
        "extracted_text_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "extracted_text_byte_length": {"type": "integer", "minimum": 0, "maximum": 500000},
        "summary": {"type": "string", "maxLength": 1000},
        "conflict_state": {"enum": ["none", "conflicted"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_kind",
        "source_url",
        "final_url",
        "source_class",
        "source_kind",
        "source_date",
        "observed_at",
        "original_source",
        "summary",
        "conflict_state",
        "body_sha256",
        "body_byte_length",
        "extracted_text_sha256",
        "extracted_text_byte_length"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/stableId"},
        "evidence_kind": {"enum": ["public_source", "durable_history"]},
        "source_url": {"oneOf": [{"$ref": "#/$defs/publicUrl"}, {"type": "null"}]},
        "final_url": {"oneOf": [{"$ref": "#/$defs/publicUrl"}, {"type": "null"}]},
        "source_class": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_kind": {"type": "string", "minLength": 1, "maxLength": 80},
        "source_date": {"type": "string", "format": "date"},
        "observed_at": {"type": "string", "format": "date-time"},
        "original_source": {"const": true},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "conflict_state": {"enum": ["none", "conflicted"]},
        "body_sha256": {"$ref": "#/$defs/hash"},
        "body_byte_length": {"type": "integer", "minimum": 1},
        "extracted_text_sha256": {"$ref": "#/$defs/hash"},
        "extracted_text_byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "typedValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "string"}, "value": {"type": "string", "minLength": 1, "maxLength": 2000}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "number"}, "value": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "boolean"}, "value": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "string_list"}, "value": {"type": "array", "minItems": 1, "maxItems": 300, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "date"}, "value": {"type": "string", "format": "date"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "url"}, "value": {"$ref": "#/$defs/publicUrl"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "object"}, "value": {"type": "object", "maxProperties": 120}}}
      ]
    },
    "categoryName": {
      "enum": [
        "identity_and_relationships",
        "company_and_commercial_context",
        "operations_and_digital_footprint",
        "audiences_market_and_reputation",
        "brand_and_messaging",
        "activity_and_signals",
        "opportunity_and_fit",
        "public_people_and_contact_paths",
        "governance_and_history",
        "evidence_coverage",
        "additional_material_facts"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "category", "subject_node_id", "typed_value", "basis", "evidence_refs", "confidence_reason", "uncertainty", "source_date", "observed_at", "freshness_state"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/stableId"},
        "category": {"$ref": "#/$defs/categoryName"},
        "subject_node_id": {"$ref": "#/$defs/stableId"},
        "typed_value": {"$ref": "#/$defs/typedValue"},
        "basis": {"enum": ["observed", "inferred_high_confidence", "inferred_low_confidence"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "confidence_reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "uncertainty": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_date": {"type": "string", "format": "date"},
        "observed_at": {"type": "string", "format": "date-time"},
        "freshness_state": {"enum": ["current", "stale", "conflicted", "unknown"]}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "coverage_state", "claims"],
      "properties": {
        "category": {"$ref": "#/$defs/categoryName"},
        "coverage_state": {"enum": ["complete", "not_found", "not_applicable", "conflicted", "stale", "unknown"]},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "gap_explanation": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "business_unit", "attributes"],
      "properties": {
        "node_id": {"$ref": "#/$defs/stableId"},
        "node_type": {"enum": ["organization", "brand", "business_role", "business_contact_route", "product_service", "audience_market", "campaign_asset_reference", "signal", "opportunity", "restriction"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "business_unit": {"const": "unreal-media-group"},
        "attributes": {"type": "object", "maxProperties": 120}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "edge_type", "from_node_id", "to_node_id", "business_unit", "claim_refs", "evidence_refs"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/stableId"},
        "edge_type": {"enum": ["parent_subbrand", "agency_client", "partner", "affiliated_with", "responsible_for", "contact_path_for", "offers", "targets", "campaign_for", "duplicate", "prior_discovery", "reengagement"]},
        "from_node_id": {"$ref": "#/$defs/stableId"},
        "to_node_id": {"$ref": "#/$defs/stableId"},
        "business_unit": {"const": "unreal-media-group"},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_data_handoff_only", "generation", "contact", "outreach", "external_write", "agent_invocation", "deployment"],
      "properties": {
        "local_data_handoff_only": {"const": true},
        "generation": {"const": false},
        "contact": {"const": false},
        "outreach": {"const": false},
        "external_write": {"const": false},
        "agent_invocation": {"const": false},
        "deployment": {"const": false}
      }
    }
  }
}
